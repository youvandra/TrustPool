# Privy app id from dashboard.privy.io. Leave empty to run with the built-in demo login.
VITE_PRIVY_APP_ID=
# demo: read @trustpool/core in the browser. api: read the Bun API through /api.
VITE_DATA=demo
# 10143 Monad testnet (default), 143 Monad, 31337 anvil. Contract addresses come from @trustpool/core.
VITE_CHAIN_ID=10143
# Optional: your own RPC instead of the public one for this chain.
VITE_RPC_URL=
