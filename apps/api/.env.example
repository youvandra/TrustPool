# demo: serve the fixed demo set. chain: index a TrustPool deployment into SQLite.
DATA=demo
PORT=8787
# Comma-separated origins for CORS; * for local work.
CORS_ORIGINS=*

# Database for chain mode. Production: a Postgres server (Neon, Supabase, Railway, RDS...).
#   postgres://user:pass@host:5432/trustpool
# Local: embedded Postgres in a folder (pglite://data/dev), or empty for in-memory.
DATABASE_URL=pglite://data/dev
# Connections in the pool (postgres:// only).
DB_POOL=10

# --- chain mode ---
# 10143 Monad testnet, 143 Monad, 31337 anvil. Addresses come from @trustpool/core
# (npm run sync:contracts) unless TRUSTPOOL_ADDRESS and START_BLOCK are set.
CHAIN_ID=10143
RPC_URL=
TRUSTPOOL_ADDRESS=
START_BLOCK=
CONFIRMATIONS=2
MAX_BLOCK_RANGE=100
POLL_MS=2000
PRICE_SAMPLE_MS=300000
# Blocks before an open scanned by /calls/:id/early-buyers (~30 min at 0.4 s blocks).
EARLY_BUYER_WINDOW_BLOCKS=4500
# Price samples older than this are pruned.
PRICE_RETAIN_DAYS=90

# --- auth ---
# From dashboard.privy.io > your app > Settings: the app id and the verification key (PEM).
# Without both, /me routes trust the X-Demo-User header: local use only.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=

# --- Telegram ---
# Posts opens, exit announcements, settlements, releases and stale marks to one chat.
# Bot token from @BotFather; chat id of the channel (-100…) or @channelname. Off unless both are set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Per-IP rate limits (token bucket, per instance). Reads: GET; writes: everything else.
RATE_READ_BURST=120
RATE_READ_PER_SEC=20
RATE_WRITE_BURST=20
RATE_WRITE_PER_SEC=2
# 1 behind a proxy you control: take the client IP from X-Forwarded-For.
TRUST_PROXY=0

# debug | info (default) | silent
LOG_LEVEL=info
