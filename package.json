{
  "name": "trustpool",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev -w @trustpool/web",
    "dev:api": "cd apps/api && bun --watch src/index.ts",
    "build": "npm run build -w @trustpool/web",
    "typecheck": "npm run typecheck -w @trustpool/core && npm run typecheck -w @trustpool/web && npm run typecheck -w @trustpool/api",
    "test": "npm run test:contracts && npm test -w @trustpool/api",
    "test:contracts": "cd contracts && forge test",
    "sync:contracts": "cd contracts && forge build && cd .. && node scripts/sync-contracts.mjs",
    "test:e2e": "npm test -w @trustpool/e2e",
    "dev:local": "node scripts/local-stack.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
