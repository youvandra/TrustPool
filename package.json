{
  "name": "trustpool",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @trustpool/web",
    "dev:api": "cd apps/api && bun --watch src/index.ts",
    "build": "npm run build -w @trustpool/web",
    "typecheck": "npm run typecheck -w @trustpool/web && npm run typecheck -w @trustpool/api",
    "test:contracts": "cd contracts && forge test"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
